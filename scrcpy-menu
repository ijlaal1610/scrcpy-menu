class ScrcpyManager:
    """Manages scrcpy subprocess with asynchronous, non-blocking log reading."""
    def __init__(self, log_callback=None, max_log_lines=500):
        self.process = None
        self.log_callback = log_callback
        self.logs = deque(maxlen=max_log_lines)
        self._reader_thread = None

    def is_running(self):
        if self.process is None:
            return False
        return self.process.poll() is None

    def _read_stream(self, pipe):
        """Continuously read lines from scrcpy stdout/stderr to avoid pipe blocking."""
        try:
            for line in iter(pipe.readline, ''):
                if not line:
                    break
                line = line.rstrip()
                self.logs.append(line)
                if self.log_callback:
                    try:
                        self.log_callback(line)
                    except Exception:
                        pass
        except Exception:
            pass
        finally:
            try:
                pipe.close()
            except Exception:
                pass

    def start(self, cmd):
        if self.is_running():
            self.stop()
        self.logs.clear()
        self.process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            preexec_fn=os.setsid
        )
        # Spawn daemon thread to drain pipe immediately and prevent buffer freeze
        self._reader_thread = threading.Thread(
            target=self._read_stream,
            args=(self.process.stdout,),
            daemon=True
        )
        self._reader_thread.start()
        return self.process

    def stop(self):
        if self.process and self.process.poll() is None:
            try:
                os.killpg(os.getpgid(self.process.pid), signal.SIGTERM)
                self.process.wait(timeout=2)
            except Exception:
                try:
                    os.killpg(os.getpgid(self.process.pid), signal.SIGKILL)
                except Exception:
                    pass
        self.process = None

    def get_logs(self):
        """Return all collected log lines as a single string."""
        return "\n".join(self.logs)


def get_connected_devices():
    try:
        res = subprocess.run(["adb", "devices"], stdout=subprocess.PIPE, text=True, check=True)
        lines = [line.split()[0] for line in res.stdout.strip().split("\n")[1:] if "\tdevice" in line]
        return lines
    except Exception:
        return []


def get_installed_apps():
    """Retrieve list of installed apps from device via scrcpy --list-apps."""
    try:
        res = subprocess.run(
            ["scrcpy", "--list-apps"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, timeout=15
        )
        apps = []
        for line in res.stdout.splitlines():
            line = line.strip()
            if line.startswith("* "):
                # Format: " * App Name                    com.package.name"
                # Split on multiple spaces to separate name from package
                parts = line[2:].rsplit(None, 1)
                if len(parts) == 2:
                    app_name, pkg = parts[0].strip(), parts[1].strip()
                    apps.append((app_name, pkg))
        return apps
    except Exception:
        return []


DESKTOP_MODE_FLAGS = [
    ("force_desktop_mode_on_external_displays", "Force desktop mode on external/virtual displays"),
    ("enable_freeform_support", "Enable freeform (resizable) windows"),
    ("force_resizable_activities", "Force all activities to be resizable"),
    ("enable_non_resizable_multi_window", "Allow non-resizable apps in multi-window"),
]


def get_desktop_mode_status():
    """Check current state of all desktop mode flags. Returns dict of flag -> bool."""
    status = {}
    for flag, _desc in DESKTOP_MODE_FLAGS:
        try:
            res = subprocess.run(
                ["adb", "shell", "settings", "get", "global", flag],
                stdout=subprocess.PIPE, text=True, timeout=3
            )
            val = res.stdout.strip()
            status[flag] = (val == "1")
        except Exception:
            status[flag] = False
    return status


def capture_desktop_mode_backup():
    """Capture current device settings before making overrides if no backup exists yet."""
    if os.path.exists(BACKUP_SETTINGS_FILE):
        return  # Keep the original baseline
    backup = {}
    for flag, _desc in DESKTOP_MODE_FLAGS:
        try:
            res = subprocess.run(
                ["adb", "shell", "settings", "get", "global", flag],
                stdout=subprocess.PIPE, text=True, timeout=3
            )
            backup[flag] = res.stdout.strip()
        except Exception:
            backup[flag] = "null"
    try:
        os.makedirs(os.path.dirname(BACKUP_SETTINGS_FILE), exist_ok=True)
        with open(BACKUP_SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(backup, f, indent=2)
    except Exception as e:
        print(f"[!] Warning: Failed to record baseline settings: {e}", file=sys.stderr)


def restore_desktop_mode_defaults():
    """Restore OEM baseline or delete overrides from Android global settings."""
    backup = {}
    if os.path.exists(BACKUP_SETTINGS_FILE):
        try:
            with open(BACKUP_SETTINGS_FILE, "r", encoding="utf-8") as f:
                backup = json.load(f)
        except Exception:
            backup = {}

    errors = []
    for flag, _desc in DESKTOP_MODE_FLAGS:
        val = backup.get(flag, "null")
        try:
            if val in ("null", ""):
                # Value was not set originally; delete override to restore OEM default
                subprocess.run(
                    ["adb", "shell", "settings", "delete", "global", flag],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    text=True, timeout=3, check=True
                )
            else:
                subprocess.run(
                    ["adb", "shell", "settings", "put", "global", flag, val],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    text=True, timeout=3, check=True
                )
        except Exception as e:
            errors.append(f"{flag}: {e}")

    # Remove backup file now that we've restored
    if os.path.exists(BACKUP_SETTINGS_FILE):
        try:
            os.remove(BACKUP_SETTINGS_FILE)
        except Exception:
            pass

    if errors:
        return False, "Errors: " + "; ".join(errors)
    return True, "Restored original Android settings defaults."


def set_desktop_mode(enable=True):
    """Enable or disable all desktop mode flags via ADB with rollback tracking. Returns (success, message)."""
    if enable:
        capture_desktop_mode_backup()
        val = "1"
    else:
        # If user explicitly chooses to disable, restore defaults rather than hardcoding 0
        return restore_desktop_mode_defaults()

    errors = []
    for flag, _desc in DESKTOP_MODE_FLAGS:
        try:
            subprocess.run(
                ["adb", "shell", "settings", "put", "global", flag, val],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, timeout=3, check=True
            )
        except Exception as e:
            errors.append(f"{flag}: {e}")
    if errors:
        return False, "Errors: " + "; ".join(errors)
    return True, "Enabled all desktop mode flags. A reboot may be needed for full effect."


