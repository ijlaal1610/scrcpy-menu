                "vd_custom_res": self.entry_vd_custom_res.get_text().strip(),
                "vd_dpi": self.combo_vd_dpi.get_active_id() or "default",
                "vd_app": self.combo_vd_app.get_active_id() or "none",
                "vd_custom_pkg": self.entry_vd_custom_pkg.get_text().strip(),
                "vd_force_stop": self.chk_vd_force_stop.get_active(),
                "vd_force_desktop": self.chk_vd_force_desktop.get_active(),
                "vd_flex": self.chk_vd_flex.get_active(),
                "vd_keep_active": self.chk_vd_keep_active.get_active(),
                "vd_no_decor": self.chk_vd_no_decor.get_active(),
                "vd_no_destroy": self.chk_vd_no_destroy.get_active(),
                "vd_audio": self.chk_vd_audio.get_active(),
                "vd_stay_awake": self.chk_vd_stay_awake.get_active(),
                "vd_screen_off": self.chk_vd_screen_off.get_active(),
                "vd_codec": self.combo_vd_codec.get_active_id() or "h264",
