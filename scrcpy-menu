            if "vd_custom_pkg" in cfg:
                self.entry_vd_custom_pkg.set_text(cfg["vd_custom_pkg"])
            self.on_vd_app_changed(self.combo_vd_app)

            if "vd_force_stop" in cfg:
                self.chk_vd_force_stop.set_active(cfg["vd_force_stop"])
            if "vd_force_desktop" in cfg:
                self.chk_vd_force_desktop.set_active(cfg["vd_force_desktop"])
            if "vd_flex" in cfg:
                self.chk_vd_flex.set_active(cfg["vd_flex"])
            if "vd_keep_active" in cfg:
                self.chk_vd_keep_active.set_active(cfg["vd_keep_active"])
            if "vd_no_decor" in cfg:
                self.chk_vd_no_decor.set_active(cfg["vd_no_decor"])
            if "vd_no_destroy" in cfg:
                self.chk_vd_no_destroy.set_active(cfg["vd_no_destroy"])
            if "vd_audio" in cfg:
                self.chk_vd_audio.set_active(cfg["vd_audio"])
            if "vd_stay_awake" in cfg:
                self.chk_vd_stay_awake.set_active(cfg["vd_stay_awake"])
            if "vd_screen_off" in cfg:
                self.chk_vd_screen_off.set_active(cfg["vd_screen_off"])

            set_combo(self.combo_vd_codec, cfg.get("vd_codec"))
            set_combo(self.combo_vd_bitrate, cfg.get("vd_bitrate"))
            set_combo(self.combo_vd_fps, cfg.get("vd_fps"))

            # Active Tab
            if "active_tab" in cfg and isinstance(cfg["active_tab"], int):
                self.notebook.set_current_page(cfg["active_tab"])

        def on_destroy(self, widget):
            self.save_settings()
            self.manager.stop()
            Gtk.main_quit()


