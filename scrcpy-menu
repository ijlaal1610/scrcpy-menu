                "vd_fps": self.combo_vd_fps.get_active_id() or "60",
            }
            save_config(cfg)

        def load_settings(self):
            """Restore previously saved UI controls from JSON configuration file."""
            cfg = load_config()
            if not cfg:
                return

            def set_combo(combo, val):
                if val:
                    combo.set_active_id(str(val))

            # Camera
            set_combo(self.combo_cam, cfg.get("cam_id"))
            set_combo(self.combo_cam_res, cfg.get("cam_res"))
            set_combo(self.combo_cam_fps, cfg.get("cam_fps"))
            if "v4l2_device" in cfg:
