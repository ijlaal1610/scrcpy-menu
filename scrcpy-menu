CONFIG_FILE = os.path.expanduser("~/.config/scrcpy-menu/config.json")
BACKUP_SETTINGS_FILE = os.path.expanduser("~/.config/scrcpy-menu/android_settings_backup.json")


def load_config():
    """Load saved settings dictionary from JSON configuration file."""
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            print(f"[!] Warning: Failed to load config from {CONFIG_FILE}: {e}", file=sys.stderr)
            return {}
    return {}


def save_config(cfg):
    """Save settings dictionary atomically to JSON configuration file."""
    try:
        conf_dir = os.path.dirname(CONFIG_FILE)
        os.makedirs(conf_dir, exist_ok=True)
        # Atomic write via tempfile in same filesystem directory
        with tempfile.NamedTemporaryFile("w", dir=conf_dir, delete=False, encoding="utf-8") as tf:
            json.dump(cfg, tf, indent=2)
            temp_path = tf.name
        os.replace(temp_path, CONFIG_FILE)
    except Exception as e:
        print(f"[!] Warning: Failed to save config to {CONFIG_FILE}: {e}", file=sys.stderr)


# Input validators for CLI & GUI security
def validate_resolution(val):
    """Validate resolution like 1920x1080 or empty/default."""
    if not val or val in ("0", "default"):
        return True
    return bool(re.match(r"^\d{3,5}x\d{3,5}$", val.strip()))


def validate_dpi(val):
    """Validate DPI integer string (e.g. 180, 240, 420) or empty/default."""
    if not val or val == "default":
        return True
    return bool(re.match(r"^\d{2,3}$", val.strip()))


def validate_package_name(val):
    """Validate Android package name or query syntax (?name, +pkg)."""
    if not val:
        return True
    val = val.lstrip("+").lstrip("?")
    return bool(re.match(r"^[a-zA-Z0-9_\.]+$", val.strip()))


def validate_bitrate(val):
    """Validate bitrate string like 8M, 16M, 4000K."""
    if not val:
        return True
    return bool(re.match(r"^\d+[kKmMgG]?$", val.strip()))


def validate_fps(val):
    """Validate FPS value like 30, 60, 120 or 0."""
    if not val:
        return True
    return bool(re.match(r"^\d{1,3}$", val.strip()))


