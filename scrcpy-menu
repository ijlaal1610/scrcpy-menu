def cli_toggle_desktop_mode():
    """Interactive CLI menu to check and toggle Android desktop mode flags."""
    print("\n── Android Desktop Mode Settings (via ADB) ──")
    status = get_desktop_mode_status()
    all_enabled = True
    for flag, desc in DESKTOP_MODE_FLAGS:
        val = status.get(flag, False)
        if not val:
            all_enabled = False
        print(f" [{'ON' if val else 'OFF'}] {desc}")
    print(f"\nOverall Status: {'✅ FULLY ENABLED' if all_enabled else '⚠️  PARTIAL / DISABLED'}")
    
    try:
        action = input("\nOptions: [1] Enable all flags  [2] Restore OEM defaults  [Enter] Keep unchanged: ").strip()
    except (EOFError, KeyboardInterrupt):
        action = ""
    if action == "1":
        succ, msg = set_desktop_mode(True)
        print(f"\n✔ {msg}")
    elif action == "2":
        succ, msg = restore_desktop_mode_defaults()
        print(f"\n✔ {msg}")
    else:
        print("No changes made.")


