        def on_launch_clicked(self, widget):
            current_page = self.notebook.get_current_page()
            cmd = ["scrcpy"]

            if current_page == 0:
                # Camera Mode
                cmd.append("--video-source=camera")
                cam_id = self.combo_cam.get_active_id()
                cmd.append(f"--camera-id={cam_id}")

                res = self.combo_cam_res.get_active_id()
                cmd.append(f"--camera-size={res}")

                fps = self.combo_cam_fps.get_active_id()
                cmd.append(f"--camera-fps={fps}")

                # Optional Anti-Lag: Bitrate limit
                if self.chk_cam_bitrate.get_active():
                    cmd.append("--video-bit-rate=8M")

                # Optional Anti-Lag: Zero buffer for V4L2
                if self.chk_cam_zero_buf.get_active():
                    cmd.append("--v4l2-buffer=0")

                # V4L2 sink
                if self.chk_cam_v4l2.get_active():
                    dev = self.entry_v4l2.get_text().strip() or "/dev/video2"
                    cmd.append(f"--v4l2-sink={dev}")

                # Desktop preview
                if not self.chk_cam_preview.get_active():
                    cmd.append("--no-video-playback")

                # Optional Anti-Lag: Disable audio
                if self.chk_cam_no_audio.get_active():
                    cmd.append("--no-audio")

            elif current_page == 1:
                # Screen Mirror Mode
                fps = self.combo_screen_fps.get_active_id()
                cmd.append(f"--max-fps={fps}")

                res = self.combo_screen_res.get_active_id()
                if res != "0":
                    cmd.append(f"-m{res}")

                if self.chk_screen_stay_awake.get_active():
                    cmd.append("--stay-awake")

                # Optional Anti-Lag: Screen off
                if self.chk_screen_off.get_active():
                    cmd.append("--turn-screen-off")

                # Audio handling for screen mirroring
                if self.chk_screen_audio.get_active():
                    cmd.append("--audio-source=output")
                else:
                    cmd.append("--no-audio")

                if self.chk_screen_v4l2.get_active():
                    dev = self.entry_v4l2.get_text().strip() or "/dev/video2"
                    cmd.append(f"--v4l2-sink={dev}")
                    if self.chk_screen_zero_buf.get_active():
                        cmd.append("--v4l2-buffer=0")

            elif current_page == 2:
                # Virtual Display Mode
                # Sync desktop mode vs standard phone mode
                force_dt = self.chk_vd_force_desktop.get_active()
                set_desktop_mode(force_dt)

                vd_res = self.combo_vd_res.get_active_id()
                vd_dpi = self.combo_vd_dpi.get_active_id()

                # Build --new-display argument
                if vd_res == "default" and vd_dpi == "default":
                    cmd.append("--new-display")
                elif vd_res == "custom":
                    custom = self.entry_vd_custom_res.get_text().strip() or "1920x1080"
                    if vd_dpi != "default":
                        cmd.append(f"--new-display={custom}/{vd_dpi}")
                    else:
                        cmd.append(f"--new-display={custom}")
                elif vd_res == "default" and vd_dpi != "default":
                    cmd.append(f"--new-display=/{vd_dpi}")
                else:
                    if vd_dpi != "default":
                        cmd.append(f"--new-display={vd_res}/{vd_dpi}")
                    else:
                        cmd.append(f"--new-display={vd_res}")

                # Flex display
                if self.chk_vd_flex.get_active():
                    cmd.append("--flex-display")

                # Start app
                app_id = self.combo_vd_app.get_active_id()
                if app_id and app_id not in ("none", "custom_pkg"):
                    prefix = "+" if self.chk_vd_force_stop.get_active() else ""
                    cmd.append(f"--start-app={prefix}{app_id}")
                elif app_id == "custom_pkg":
                    custom_pkg = self.entry_vd_custom_pkg.get_text().strip()
                    if custom_pkg:
                        prefix = "+" if self.chk_vd_force_stop.get_active() else ""
                        cmd.append(f"--start-app={prefix}{custom_pkg}")

                # Keep active
                if self.chk_vd_keep_active.get_active():
                    cmd.append("--keep-active")

                # No system decorations
                if self.chk_vd_no_decor.get_active():
                    cmd.append("--no-vd-system-decorations")

                # No destroy content
                if self.chk_vd_no_destroy.get_active():
                    cmd.append("--no-vd-destroy-content")

                # Audio
                if self.chk_vd_audio.get_active():
                    cmd.append("--audio-source=output")
                else:
                    cmd.append("--no-audio")

                # Stay awake & Screen off (prevents freeze)
                if self.chk_vd_stay_awake.get_active():
                    cmd.append("--stay-awake")

                if self.chk_vd_screen_off.get_active():
                    cmd.append("--turn-screen-off")

                # Video codec
                codec = self.combo_vd_codec.get_active_id()
                if codec != "h264":
                    cmd.append(f"--video-codec={codec}")

                # Bitrate
                bitrate = self.combo_vd_bitrate.get_active_id()
                cmd.append(f"--video-bit-rate={bitrate}")

                # Max FPS
                vd_fps = self.combo_vd_fps.get_active_id()
                if vd_fps != "0":
                    cmd.append(f"--max-fps={vd_fps}")

            try:
                self.save_settings()
                self.manager.start(cmd)
                self.status_label.set_text(f"Running: {' '.join(cmd)}")
                self.btn_launch.set_sensitive(False)
                self.btn_stop.set_sensitive(True)
            except Exception as e:
                self.status_label.set_text(f"Error starting: {e}")

        def on_stop_clicked(self, widget):
            self.manager.stop()
            self.status_label.set_text("Stopped.")
            self.btn_launch.set_sensitive(True)
            self.btn_stop.set_sensitive(False)

        def check_process_status(self):
            if not self.manager.is_running() and self.btn_stop.get_sensitive():
                self.status_label.set_text("Scrcpy stopped.")
                self.btn_launch.set_sensitive(len(get_connected_devices()) > 0)
                self.btn_stop.set_sensitive(False)
            return True

        def save_settings(self):
            """Save all current UI controls to the JSON configuration file."""
            cfg = {
                "active_tab": self.notebook.get_current_page(),
                # Camera Tab
                "cam_id": self.combo_cam.get_active_id() or "0",
                "cam_res": self.combo_cam_res.get_active_id() or "1920x1080",
                "cam_fps": self.combo_cam_fps.get_active_id() or "30",
                "v4l2_device": self.entry_v4l2.get_text().strip(),
                "cam_v4l2": self.chk_cam_v4l2.get_active(),
                "cam_preview": self.chk_cam_preview.get_active(),
                "cam_no_audio": self.chk_cam_no_audio.get_active(),
                "cam_zero_buf": self.chk_cam_zero_buf.get_active(),
                "cam_bitrate": self.chk_cam_bitrate.get_active(),
                # Screen Mirror Tab
                "screen_fps": self.combo_screen_fps.get_active_id() or "120",
                "screen_res": self.combo_screen_res.get_active_id() or "0",
                "screen_stay_awake": self.chk_screen_stay_awake.get_active(),
                "screen_audio": self.chk_screen_audio.get_active(),
