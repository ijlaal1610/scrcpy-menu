def cli_custom_virtual_display():
    """Interactive builder for a custom virtual display command with strict validation."""
    print("\n── Custom Virtual Display Builder ──")

    # Resolution
    print("\nResolution:")
    print("  1) 1920x1080 (Full HD)")
    print("  2) 2560x1440 (QHD)")
    print("  3) 1280x720 (HD)")
    print("  4) 1024x768 (4:3 Tablet)")
    print("  5) Device Default")
    print("  6) Custom")
    r = input("Choice [1]: ").strip() or "1"
    res_map = {"1": "1920x1080", "2": "2560x1440", "3": "1280x720", "4": "1024x768", "5": "", "6": ""}
    if r == "6":
        res = input("Enter WxH (e.g. 1920x1080): ").strip()
        if not validate_resolution(res):
            print(f"[!] Invalid resolution format '{res}'. Defaulting to 1920x1080.")
            res = "1920x1080"
    else:
        res = res_map.get(r, "1920x1080")

    # DPI
    print("\nDPI:")
    print("  1) Device Default")
    print("  2) 420 (Recommended for FHD)")
    print("  3) 320 (Compact)")
    print("  4) 240 (Tablet-like)")
    print("  5) 180 (Desktop Mode)")
    d = input("Choice [1]: ").strip() or "1"
    dpi_map = {"1": "", "2": "420", "3": "320", "4": "240", "5": "180"}
    dpi = dpi_map.get(d, "")
    if dpi and not validate_dpi(dpi):
        print(f"[!] Invalid DPI value '{dpi}'. Using default.")
        dpi = ""

    # Build new-display arg
    if res and dpi:
        nd = f"--new-display={res}/{dpi}"
    elif res:
        nd = f"--new-display={res}"
    elif dpi:
        nd = f"--new-display=/{dpi}"
    else:
        nd = "--new-display"

    parts = ["scrcpy", nd]

    # Flex display
    flex = input("\nEnable Flex Display (resizable window)? [Y/n]: ").strip().lower()
    if flex != "n":
        parts.append("--flex-display")

    # Start app
    app = input("Start an app? Enter package name, '?' to search, or press Enter to skip: ").strip()
    if app:
        if not validate_package_name(app):
            print(f"[!] Rejected unsafe package name format: '{app}'. Skipping app start.")
        else:
            force = input("  Force-stop app first? [y/N]: ").strip().lower()
            prefix = "+" if force == "y" else ""
            parts.append(f"--start-app={prefix}{app}")

    # Keep active
    keep = input("Keep display active? [Y/n]: ").strip().lower()
    if keep != "n":
        parts.append("--keep-active")

    # No destroy content
    preserve = input("Preserve apps on close (move to main display)? [Y/n]: ").strip().lower()
    if preserve != "n":
        parts.append("--no-vd-destroy-content")

    # No system decorations
    decor = input("Remove system decorations (status/nav bar)? [y/N]: ").strip().lower()
    if decor == "y":
        parts.append("--no-vd-system-decorations")

    # Audio
    audio = input("Forward audio to PC? [Y/n]: ").strip().lower()
    if audio != "n":
        parts.append("--audio-source=output")
    else:
        parts.append("--no-audio")

    # Codec
    print("\nVideo Codec:")
    print("  1) H.264 (Compatible)")
    print("  2) H.265/HEVC (Better quality)")
    print("  3) AV1 (Best, needs modern device)")
    c = input("Choice [1]: ").strip() or "1"
    if c == "2":
        parts.append("--video-codec=h265")
    elif c == "3":
        parts.append("--video-codec=av1")

    # Bitrate
    br = input("Bitrate (e.g. 8M, 16M) [8M]: ").strip() or "8M"
    if not validate_bitrate(br):
        print(f"[!] Invalid bitrate '{br}'. Defaulting to 8M.")
        br = "8M"
    parts.append(f"--video-bit-rate={br}")

    # Max FPS
    fps = input("Max FPS (0=unlimited) [60]: ").strip() or "60"
    if not validate_fps(fps):
        print(f"[!] Invalid FPS '{fps}'. Defaulting to 60.")
        fps = "60"
    if fps != "0":
        parts.append(f"--max-fps={fps}")

    return parts


