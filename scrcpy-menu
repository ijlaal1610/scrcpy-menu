        def on_vd_force_desktop_toggled(self, widget):
            """Sync Android desktop mode ADB flags when user toggles the switch."""
            enable = widget.get_active()
            val_desc = "desktop mode" if enable else "standard phone mode"
            self.status_label.set_text(f"Configuring Android for {val_desc} via ADB...")
            set_desktop_mode(enable)
            self.update_desktop_mode_status()
            self.status_label.set_text(f"Set to {val_desc}. Note: reboot phone if changing mode for first time.")

        def on_reload_apps_clicked(self, widget):
            """Scan device for installed apps and populate the combo."""
            self.status_label.set_text("Scanning device apps... (this may take a few seconds)")
            # Run in a thread-safe manner using GLib.idle_add
            while Gtk.events_pending():
                Gtk.main_iteration()

            apps = get_installed_apps()
            if apps:
                # Preserve special entries
                self.combo_vd_app.remove_all()
                self.combo_vd_app.append("none", "(None — open blank virtual display)")
                for app_name, pkg in sorted(apps, key=lambda x: x[0]):
                    self.combo_vd_app.append(pkg, f"{app_name} ({pkg})")
                self.combo_vd_app.append("custom_pkg", "📦 Custom package name...")
                self.combo_vd_app.set_active(0)
                self.status_label.set_text(f"Found {len(apps)} apps on device.")
            else:
                self.status_label.set_text("Could not retrieve apps. Is the device connected?")

        def update_desktop_mode_status(self):
            """Check device for desktop flags and update UI label."""
            status = get_desktop_mode_status()
            lines = []
            all_enabled = True
            for flag, desc in DESKTOP_MODE_FLAGS:
                val = status.get(flag, False)
                if not val:
                    all_enabled = False
                icon = "🟢 ON " if val else "🔴 OFF"
                lines.append(f"<tt>{icon}</tt> <small>{desc}</small>")
            summary = "<span color='green'><b>Desktop Mode: Fully Enabled</b></span>" if all_enabled else "<span color='#d97706'><b>Desktop Mode: Partially or Not Enabled</b></span>"
            self.lbl_desktop_status.set_markup(f"{summary}\n" + "\n".join(lines))

