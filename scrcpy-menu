        def refresh_devices(self, widget=None):
            devices = get_connected_devices()
            if devices:
                self.dev_label.set_markup(f"<b>Device:</b> <span color='green'>{devices[0]} (Connected)</span>")
                self.btn_launch.set_sensitive(not self.manager.is_running())
            else:
                self.dev_label.set_markup("<b>Device:</b> <span color='red'>No ADB device detected</span>")
                self.btn_launch.set_sensitive(False)

        def populate_cameras(self):
            """Populate the camera ComboBox with available camera IDs from scrcpy."""
            try:
                result = subprocess.run(
                    ["scrcpy", "--list-cameras"],
                    stdout=subprocess.PIPE,
                    text=True,
                    check=True,
                )
                lines = result.stdout.splitlines()
            except Exception:
                lines = []

            # Clear existing entries
            self.combo_cam.remove_all()
            for line in lines:
                line = line.strip()
                if line.startswith("--camera-id="):
                    parts = line.split()
                    cam_id = parts[0].split("=")[1]
                    desc = ""
                    if "(" in line and ")" in line:
                        desc = line[line.find("(")+1:line.find(")")]
                    label = f"Camera {cam_id} ({desc})" if desc else f"Camera {cam_id}"
                    self.combo_cam.append(cam_id, label)

            # Fallback defaults if none detected
            if self.combo_cam.get_model() is None or len(self.combo_cam.get_model()) == 0:
                self.combo_cam.append("0", "Back Camera (id 0)")
                self.combo_cam.append("1", "Front Camera (id 1)")

            # Select first entry by default
            if self.combo_cam.get_active_id() is None:
                self.combo_cam.set_active(0)

