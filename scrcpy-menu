            if "cam_bitrate" in cfg:
                self.chk_cam_bitrate.set_active(cfg["cam_bitrate"])

            # Screen Mirror
            set_combo(self.combo_screen_fps, cfg.get("screen_fps"))
            set_combo(self.combo_screen_res, cfg.get("screen_res"))
            if "screen_stay_awake" in cfg:
